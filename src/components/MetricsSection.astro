---
import ContentWidth from "./ContentWidth.astro";
---

<section class="py-16 md:py-24">
    <ContentWidth>
        <div class="flex flex-col items-center text-center">

            <h2 class="text-3xl md:text-5xl font-extrabold text-secondary-950 max-w-4xl leading-[1.1] tracking-tight">
                Servitec Work <span class="text-primary-500">—</span> la red de servicios técnicos que más crece en Perú.
            </h2>

            <div class="grid grid-cols-1 md:grid-cols-3 mt-16 md:mt-24 w-full max-w-5xl divide-y md:divide-y-0 md:divide-x divide-secondary-950/10 border-y md:border-y-0 border-secondary-950/10">

                <div class="flex flex-col items-center py-8 md:py-0 md:px-8">
                    <span class="text-6xl md:text-7xl font-extrabold text-secondary-950 tracking-tighter">
                        +500
                    </span>
                    <p class="text-secondary-950/70 font-semibold mt-3 text-lg md:text-xl tracking-tight">
                        descargas locales
                    </p>
                </div>

                <div class="flex flex-col items-center py-8 md:py-0 md:px-8">
                    <span class="text-6xl md:text-7xl font-extrabold text-secondary-950 tracking-tighter">
                        100%
                    </span>
                    <p class="text-secondary-950/70 font-semibold mt-3 text-lg md:text-xl tracking-tight">
                        trato directo
                    </p>
                </div>

                <div class="flex flex-col items-center py-8 md:py-0 md:px-8">
                    <div class="flex items-baseline gap-1">
                        <span class="text-3xl md:text-4xl font-extrabold text-primary-500">S/</span>
                        <span class="text-6xl md:text-7xl font-extrabold text-secondary-950 tracking-tighter">5</span>
                    </div>
                    <p class="text-secondary-950/70 font-semibold mt-3 text-lg md:text-xl tracking-tight">
                        tarifa fija por servicio
                    </p>
                </div>

            </div>
        </div>
    </ContentWidth>
</section>