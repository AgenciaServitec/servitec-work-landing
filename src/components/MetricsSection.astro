---
// src/components/StatsSection.astro
import ContentWidth from "./ContentWidth.astro";
---

<section class="pb-12">
    <ContentWidth>
        <div class="flex flex-col items-center text-center">
            <h2 class="text-3xl md:text-5xl font-bold text-secondary-950 max-w-3xl leading-tight tracking-tight">
                Servitec Work — la red de servicios técnicos que más crece en Perú
            </h2>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-12 md:gap-24 mt-20 w-full max-w-5xl">

                <div class="flex flex-col items-center">
          <span class="text-6xl md:text-7xl font-bold text-secondary-950 tracking-tighter">
            +500
          </span>
                    <p class="text-secondary-600 font-medium mt-4 text-lg">
                        descargas locales
                    </p>
                </div>

                <div class="flex flex-col items-center">
          <span class="text-6xl md:text-7xl font-bold text-secondary-950 tracking-tighter">
            100%
          </span>
                    <p class="text-secondary-600 font-medium mt-4 text-lg">
                        trato directo
                    </p>
                </div>

                <div class="flex flex-col items-center">
                    <div class="flex items-baseline">
                        <span class="text-3xl md:text-4xl font-bold text-secondary-950 mr-1">S/</span>
                        <span class="text-6xl md:text-7xl font-bold text-secondary-950 tracking-tighter">5</span>
                    </div>
                    <p class="text-secondary-600 font-medium mt-4 text-lg">
                        tarifa fija por servicio
                    </p>
                </div>

            </div>
        </div>
    </ContentWidth>
</section>