---
import ContentWidth from "./ContentWidth.astro";
---
<header class="absolute top-0 w-full z-50 py-4">
  <ContentWidth>
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-3">
        <img src="/logo.png" alt="Servitec Work Logo" class="w-12 h-12 object-contain" />
        <span class="text-2xl font-bold text-secondary-950 tracking-tight hidden sm:block">
          Servitec Work
        </span>
      </div>

      <div class="flex items-center gap-3">
        <button class="flex items-center gap-2 bg-secondary-950/5 hover:bg-secondary-950/10 text-secondary-950 px-4 py-2 rounded-full font-medium transition-colors">
          <img src="https://flagcdn.com/w20/pe.png" alt="ES" class="w-5 h-5 rounded-full object-cover shadow-sm" />
          Es
        </button>
      </div>
    </div>
  </ContentWidth>
</header>