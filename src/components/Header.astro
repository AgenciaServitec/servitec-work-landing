---
import ContentWidth from "./ContentWidth.astro";
---
<header class="absolute top-0 w-full z-50 py-6 md:py-8">
  <ContentWidth>
    <nav class="flex items-center justify-between" aria-label="Navegación principal">

      <a href="/" class="flex items-center gap-3.5 transition-opacity hover:opacity-90">
        <img
            src="/logo.png"
            alt="Servitec Work Logo"
            class="w-11 h-11 md:w-12 md:h-12 object-contain"
        />
        <span class="text-xl md:text-2xl font-extrabold text-secondary-950 tracking-tight hidden sm:block">
          Servitec Work
        </span>
      </a>

      <div class="flex items-center">
        <button class="flex items-center gap-2.5 text-secondary-950 text-sm font-semibold transition-opacity hover:opacity-70 focus:outline-none">
          <img
              src="https://flagcdn.com/w20/pe.png"
              alt="Perú"
              class="w-5 h-5 rounded-full object-cover shadow-sm border border-secondary-950/10"
          />
          <span class="tracking-wide">ES</span>
        </button>
      </div>

    </nav>
  </ContentWidth>
</header>