---
import ContentWidth from "../components/ContentWidth.astro";
---

<section class="relative min-h-[100dvh] flex items-center overflow-hidden pt-32 pb-16 lg:pt-0 lg:pb-0">
  <ContentWidth>
    <div class="w-full grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center z-10">

      <div class="flex flex-col items-start gap-8 md:gap-10">
        <h1 class="text-5xl md:text-6xl lg:text-[4.5rem] font-extrabold text-secondary-950 leading-[1.05] tracking-tight">
          Solicita técnicos expertos a un <span class="text-primary-500">precio justo</span>.
        </h1>

        <a
            href="https://play.google.com/store/apps/details?id=com.servitec.workapp&hl=es"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center bg-primary-400 hover:bg-primary-500 text-secondary-950 font-bold text-lg md:text-xl px-8 py-4 rounded-2xl transition-colors shadow-sm"
        >
          Descargar la aplicación
        </a>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-6 w-full pt-4 md:pt-6 border-t border-secondary-950/10 mt-2">

          <div class="flex items-center gap-3.5">
            <svg class="w-6 h-6 text-primary-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            <span class="text-secondary-950 font-semibold tracking-tight text-lg">Pon un precio justo</span>
          </div>

          <div class="flex items-center gap-3.5">
            <svg class="w-6 h-6 text-primary-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
            <span class="text-secondary-950 font-semibold tracking-tight text-lg">Técnicos verificados</span>
          </div>

          <div class="flex items-center gap-3.5">
            <svg class="w-6 h-6 text-primary-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
            <span class="text-secondary-950 font-semibold tracking-tight text-lg">Trato directo</span>
          </div>

          <div class="flex items-center gap-3.5">
            <svg class="w-6 h-6 text-primary-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
            <span class="text-secondary-950 font-semibold tracking-tight text-lg">Garantía en servicio</span>
          </div>

        </div>
      </div>

      <div class="relative w-full aspect-[4/3] rounded-[2rem] overflow-hidden shadow-xl border border-secondary-950/5 mt-4 lg:mt-0">
        <img
            src="/hero-image.png"
            alt="Técnico profesional reparando computadora"
            class="w-full h-full object-cover transition-transform duration-700 hover:scale-105"
        />
      </div>

    </div>
  </ContentWidth>
</section>