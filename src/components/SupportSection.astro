---
import ContentWidth from "./ContentWidth.astro";
---

<section class="py-12">
    <ContentWidth>
        <div class="bg-primary-100/50 border border-primary-200/50 rounded-[2.5rem] overflow-hidden flex flex-col lg:flex-row items-stretch min-h-[500px]">

            <div class="flex-1 p-10 md:p-16 flex flex-col justify-center">
                <h2 class="text-4xl md:text-5xl font-bold text-secondary-950 mb-6 tracking-tight leading-tight">
                    Tu seguridad es nuestra prioridad, siempre.
                </h2>

                <p class="text-secondary-700 font-medium text-lg mb-10 leading-relaxed max-w-xl">
                    Contamos con un sistema de verificación de identidad para cada técnico y un equipo de soporte disponible las 24 horas del día, los 7 días de la semana, para asistirte en cualquier momento.
                </p>

                <div class="flex flex-col sm:flex-row gap-4">
                    <a
                            href="https://wa.me/51941801827"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-flex items-center justify-center bg-primary-400 hover:bg-primary-500 text-secondary-950 font-semibold px-8 py-4 rounded-full transition-all hover:scale-105 active:scale-95 shadow-xl shadow-primary-400/30"
                    >
                        Soporte 24/7
                    </a>
                </div>
            </div>

            <div class="flex-1 relative min-h-[350px] lg:min-h-full">
                <img
                        src="/servicio-tecnico-24-horas.webp"
                        alt="Soporte técnico Servitec Work"
                        class="absolute inset-0 w-full h-full object-cover"
                />
                <div class="absolute inset-0 bg-gradient-to-r from-primary-100/40 to-transparent"></div>
            </div>

        </div>
    </ContentWidth>
</section>