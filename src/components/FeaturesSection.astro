---
import ContentWidth from "./ContentWidth.astro";
---

<section class="py-24">
    <ContentWidth>
        <div class="flex flex-col items-center">
      <span class="bg-primary-100 text-secondary-900 text-xs font-bold px-4 py-1.5 rounded-full uppercase tracking-widest mb-6">
        App Servitec Work
      </span>

            <h2 class="text-4xl md:text-5xl font-bold text-secondary-950 text-center mb-16 tracking-tight">
                La app para reparaciones justas
            </h2>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-stretch w-full max-w-6xl">

                <div class="bg-white rounded-[2rem] p-10 md:p-14 shadow-sm border border-secondary-100 flex flex-col justify-center gap-10">

                    <div class="flex gap-6">
                        <div class="flex-shrink-0 w-12 h-12 bg-primary-400 rounded-2xl flex items-center justify-center text-secondary-950">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                        </div>
                        <div>
                            <h3 class="text-xl font-black text-secondary-950 mb-2">Haz tu solicitud</h3>
                            <p class="text-secondary-600 font-medium leading-relaxed">
                                Describe el problema, sube fotos y envía tu solicitud a los técnicos cercanos.
                            </p>
                        </div>
                    </div>

                    <div class="flex gap-6">
                        <div class="flex-shrink-0 w-12 h-12 bg-primary-400 rounded-2xl flex items-center justify-center text-secondary-950">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                        </div>
                        <div>
                            <h3 class="text-xl font-black text-secondary-950 mb-2">Conecta con el experto</h3>
                            <p class="text-secondary-600 font-medium leading-relaxed">
                                El técnico acepta tu solicitud y se comunica contigo directamente para coordinar la visita.
                            </p>
                        </div>
                    </div>

                    <div class="flex gap-6">
                        <div class="flex-shrink-0 w-12 h-12 bg-primary-400 rounded-2xl flex items-center justify-center text-secondary-950">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                        </div>
                        <div>
                            <h3 class="text-xl font-black text-secondary-950 mb-2">Identidad verificada</h3>
                            <p class="text-secondary-600 font-medium leading-relaxed">
                                Validamos los documentos y la identidad de cada técnico antes de que puedan aceptar trabajos.
                            </p>
                        </div>
                    </div>

                </div>

                <div class="bg-blue-100 rounded-[2rem] flex items-center justify-center p-8 overflow-hidden">
                    <div class="relative w-full max-w-[280px] aspect-[9/19] bg-secondary-950 rounded-[3rem] border-[8px] border-secondary-900 shadow-2xl overflow-hidden">
                        <div class="absolute inset-0 bg-white p-4 flex flex-col gap-4">
                            <div class="w-full h-8 bg-secondary-100 rounded-full"></div>
                            <div class="w-full h-32 bg-primary-50 rounded-2xl border-2 border-dashed border-primary-200 flex items-center justify-center">
                                <span class="text-primary-400 font-bold text-xs">FOTO DEL PROBLEMA</span>
                            </div>
                            <div class="space-y-2 mt-4">
                                <div class="w-3/4 h-3 bg-secondary-100 rounded-full"></div>
                                <div class="w-full h-3 bg-secondary-100 rounded-full"></div>
                            </div>
                            <div class="mt-auto w-full h-12 bg-primary-400 rounded-xl flex items-center justify-center font-bold text-sm">
                                Enviar Solicitud
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </ContentWidth>
</section>