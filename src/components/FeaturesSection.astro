---
import ContentWidth from "../components/ContentWidth.astro";
---

<section class="py-24 overflow-hidden">
    <ContentWidth>
        <div class="flex flex-col items-center">

            <span class="text-secondary-950 text-xs font-bold px-4 py-1.5 rounded-full border border-secondary-950/10 uppercase tracking-widest mb-6">
                App Servitec Work
            </span>

            <h2 class="text-4xl md:text-5xl lg:text-[3.5rem] font-extrabold text-secondary-950 text-center mb-16 md:mb-24 tracking-tight leading-tight">
                La app para reparaciones justas.
            </h2>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-20 items-center w-full max-w-6xl">

                <div class="flex flex-col justify-center gap-12">

                    <div class="flex gap-6">
                        <div class="flex-shrink-0 mt-1 text-primary-500">
                            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                        </div>
                        <div>
                            <h3 class="text-xl md:text-2xl font-bold text-secondary-950 mb-2 tracking-tight">Haz tu solicitud</h3>
                            <p class="text-secondary-950/70 font-medium leading-relaxed text-lg">
                                Describe el problema y envía tu solicitud a los técnicos cercanos.
                            </p>
                        </div>
                    </div>

                    <div class="flex gap-6">
                        <div class="flex-shrink-0 mt-1 text-primary-500">
                            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                        </div>
                        <div>
                            <h3 class="text-xl md:text-2xl font-bold text-secondary-950 mb-2 tracking-tight">Conecta con el experto</h3>
                            <p class="text-secondary-950/70 font-medium leading-relaxed text-lg">
                                El técnico acepta tu solicitud y se comunica contigo para coordinar la visita.
                            </p>
                        </div>
                    </div>

                    <div class="flex gap-6">
                        <div class="flex-shrink-0 mt-1 text-primary-500">
                            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                        </div>
                        <div>
                            <h3 class="text-xl md:text-2xl font-bold text-secondary-950 mb-2 tracking-tight">Identidad verificada</h3>
                            <p class="text-secondary-950/70 font-medium leading-relaxed text-lg">
                                Validamos los documentos de cada técnico antes de que puedan aceptar trabajos.
                            </p>
                        </div>
                    </div>

                </div>

                <div class="flex items-center justify-center lg:justify-end group h-full relative">

                    <div class="relative w-full max-w-[340px] md:max-w-[380px] aspect-[4/5] rounded-[2.5rem] shadow-[0_20px_50px_rgb(0,0,0,0.08)] border border-secondary-950/5 overflow-hidden transform transition-transform duration-700 group-hover:-translate-y-2">

                        <img
                                src="/feature-image.jpg"
                                alt="Usuario solicitando servicio técnico desde la app"
                                class="w-full h-full object-cover object-[center_top]"
                                loading="lazy"
                                decoding="async"
                        />

                        <div class="absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-black/10 to-transparent pointer-events-none"></div>

                    </div>

                    <div class="absolute -right-2 sm:-right-6 lg:-right-10 top-20 bg-white/90 backdrop-blur-md p-3.5 rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.06)] border border-secondary-950/5 flex items-center gap-3 animate-float hidden md:flex z-10">
                        <div class="flex items-center justify-center text-primary-500">
                            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
                        </div>
                        <div class="flex flex-col pr-3">
                            <span class="text-[10px] text-secondary-950/50 font-bold uppercase tracking-wider">Calidad</span>
                            <span class="text-sm font-extrabold text-secondary-950 text-nowrap">5.0 Garantizado</span>
                        </div>
                    </div>

                </div>

            </div>
        </div>
    </ContentWidth>
</section>

<style>
    .animate-float {
        animation: float 6s ease-in-out infinite;
        will-change: transform;
    }
    @keyframes float {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-10px); }
    }
</style>