---
import ContentWidth from "../components/ContentWidth.astro";
---

<section class="py-24 overflow-hidden">
    <ContentWidth>
        <div class="flex flex-col items-center">
            <!-- Badge superior -->
            <span class="bg-primary-100 text-secondary-900 text-xs font-bold px-4 py-1.5 rounded-full uppercase tracking-widest mb-6">
                App Servitec Work
            </span>

            <!-- Título principal -->
            <h2 class="text-4xl md:text-5xl font-bold text-secondary-950 text-center mb-16 tracking-tight">
                La app para reparaciones justas
            </h2>

            <!-- Contenedor Grid con altura controlada -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center w-full max-w-6xl">

                <!-- Columna Izquierda: Los Pasos/Beneficios -->
                <div class="flex flex-col justify-center gap-10">
                    <!-- Paso 1 -->
                    <div class="flex gap-6">
                        <div class="flex-shrink-0 w-12 h-12 bg-primary-400 rounded-2xl flex items-center justify-center text-secondary-950">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                        </div>
                        <div>
                            <h3 class="text-xl font-bold text-secondary-950 mb-2">Haz tu solicitud</h3>
                            <p class="text-secondary-600 font-medium leading-relaxed">
                                Describe el problema y envía tu solicitud a los técnicos cercanos.
                            </p>
                        </div>
                    </div>

                    <!-- Paso 2 -->
                    <div class="flex gap-6">
                        <div class="flex-shrink-0 w-12 h-12 bg-primary-400 rounded-2xl flex items-center justify-center text-secondary-950">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                        </div>
                        <div>
                            <h3 class="text-xl font-bold text-secondary-950 mb-2">Conecta con el experto</h3>
                            <p class="text-secondary-600 font-medium leading-relaxed">
                                El técnico acepta tu solicitud y se comunica contigo para coordinar la visita.
                            </p>
                        </div>
                    </div>

                    <!-- Paso 3 -->
                    <div class="flex gap-6">
                        <div class="flex-shrink-0 w-12 h-12 bg-primary-400 rounded-2xl flex items-center justify-center text-secondary-950">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                        </div>
                        <div>
                            <h3 class="text-xl font-bold text-secondary-950 mb-2">Identidad verificada</h3>
                            <p class="text-secondary-600 font-medium leading-relaxed">
                                Validamos los documentos de cada técnico antes de que puedan aceptar trabajos.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Columna Derecha: Imagen balanceada y enmarcada -->
                <div class="flex items-center justify-center lg:justify-end group h-full relative">

                    <!-- Contenedor con altura restringida para igualar al texto -->
                    <div class="relative w-full max-w-[360px] md:max-w-[420px] h-[500px] lg:h-[550px] rounded-[2.5rem] shadow-2xl overflow-hidden border-4 border-white transform transition-transform duration-700 group-hover:-translate-y-2">

                        <!-- Imagen con object-cover y object-top -->
                        <img
                                src="/feature-image.jpg"
                                alt="Usuario solicitando servicio técnico desde la app"
                                class="w-full h-full object-cover object-[center_top] image-pixel-perfect"
                                loading="eager"
                                decoding="sync"
                        />

                        <!-- Overlay sutil en la parte inferior para que el badge resalte más si se sobrepone -->
                        <div class="absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-black/20 to-transparent pointer-events-none"></div>

                    </div>

                    <!-- Badge Flotante (Detalle de Calidad) - Ahora posicionado relativo al contenedor padre -->
                    <div class="absolute -right-4 sm:right-0 lg:-right-8 top-16 bg-white p-3 rounded-2xl shadow-xl border border-secondary-100 flex items-center gap-3 animate-float hidden md:flex z-10">
                        <div class="w-10 h-10 bg-primary-100 text-primary-600 rounded-full flex items-center justify-center">
                            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
                        </div>
                        <div class="flex flex-col pr-2">
                            <span class="text-[10px] text-secondary-500 font-bold uppercase tracking-wider">Calidad</span>
                            <span class="text-sm font-bold text-secondary-950 text-nowrap">5.0 Garantizado</span>
                        </div>
                    </div>

                </div>

            </div>
        </div>
    </ContentWidth>
</section>

<style>
    .image-pixel-perfect {
        image-rendering: -webkit-optimize-contrast;
        image-rendering: pixelated;
        transform: translateZ(0);
        backface-visibility: hidden;
    }

    .animate-float {
        animation: float 6s ease-in-out infinite;
    }
    @keyframes float {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-10px); }
    }
</style>