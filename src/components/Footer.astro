---
import ContentWidth from "./ContentWidth.astro";
---

<footer class="bg-primary-50 pt-20 md:pt-24 mt-8">
  <ContentWidth>
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12 pb-16 md:pb-20">

      <div class="flex flex-col gap-6 col-span-1 md:col-span-2">
        <div class="flex items-center gap-3.5 transition-opacity hover:opacity-90">
          <img
              src="/logo.png"
              alt="Logo de Servitec Work"
              class="w-10 h-10 md:w-11 md:h-11 object-contain"
          />
          <span class="text-secondary-950 font-extrabold text-xl md:text-2xl tracking-tight">Servitec Work</span>
        </div>
        <p class="text-secondary-950/70 text-sm md:text-base leading-relaxed max-w-sm font-medium">
          Conectamos a los mejores técnicos del Perú con clientes que buscan soluciones rápidas y precios justos.
        </p>
      </div>

      <div class="hidden md:block"></div>

      <div class="flex flex-col gap-5">
        <h3 class="text-secondary-950 font-extrabold text-base tracking-tight">Comunidad</h3>
        <div class="flex gap-5">
          <a href="#" aria-label="Facebook" class="text-secondary-950/50 hover:text-primary-500 hover:-translate-y-0.5 transition-all duration-300">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M9 8H6v4h3v12h5V12h3.642L18 8h-4V6.333C14 5.378 14.792 5 15.298 5H18V0h-4.223C9.392 0 9 3.65 9 5.833V8z"/></svg>
          </a>
          <a href="#" aria-label="Instagram" class="text-secondary-950/50 hover:text-primary-500 hover:-translate-y-0.5 transition-all duration-300">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.668-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4.162 4.162 0 110-8.324 4.162 4.162 0 010 8.324zM18.406 3.506a1.44 1.44 0 100 2.88 1.44 1.44 0 000-2.88z"/></svg>
          </a>
        </div>
      </div>

    </div>

    <div class="border-t border-secondary-950/10 py-8 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-sm text-secondary-950/50 font-medium text-center md:text-left">
        &copy; {new Date().getFullYear()} <span class="text-secondary-950 font-bold">Servitec Work</span>. Todos los derechos reservados.
      </p>
      <p class="text-sm text-secondary-950/50 font-medium">
        Hecho en Perú.
      </p>
    </div>
  </ContentWidth>
</footer>