---
import { Image } from "astro:assets";
import ContentWidth from "./ContentWidth.astro";
---

<footer class="bg-secondary-950 border-t border-secondary-800 pt-16">
  <ContentWidth>
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12 pb-12">

      <div class="flex flex-col gap-4 col-span-1 md:col-span-1">
        <Image
            src="/logo.png"
            alt="Logo de Servitec"
            width={120}
            height={40}
            class="brightness-110"
        />
        <p class="text-secondary-400 text-sm leading-relaxed mt-2">
          Servitec Work – Soluciones técnicas a un paso. Clientes y técnicos conectados con transparencia y comisión justa.
        </p>
      </div>

      <div class="flex flex-col gap-4">
        <h3 class="text-white font-bold text-lg">Compañía</h3>
        <ul class="flex flex-col gap-2 text-secondary-400 text-sm">
          <li><a href="/#about" class="hover:text-primary-400 transition-colors">Sobre nosotros</a></li>
          <li><a href="/#jobs" class="hover:text-primary-400 transition-colors">Portafolio</a></li>
          <li><a href="/#services" class="hover:text-primary-400 transition-colors">Servicios</a></li>
        </ul>
      </div>

      <div class="flex flex-col gap-4">
        <h3 class="text-white font-bold text-lg">Soporte</h3>
        <ul class="flex flex-col gap-2 text-secondary-400 text-sm">
          <li><a href="/contact" class="hover:text-primary-400 transition-colors">Centro de ayuda</a></li>
          <li><a href="/terms" class="hover:text-primary-400 transition-colors">Términos y condiciones</a></li>
          <li><a href="/privacy" class="hover:text-primary-400 transition-colors">Privacidad</a></li>
        </ul>
      </div>

      <div class="flex flex-col gap-4">
        <h3 class="text-white font-bold text-lg">Síguenos</h3>
        <div class="flex gap-4">
          <a href="#" class="w-10 h-10 rounded-full bg-secondary-900 border border-secondary-700 flex items-center justify-center hover:border-primary-500 hover:text-primary-500 transition-all text-secondary-100">
            FB
          </a>
          <a href="#" class="w-10 h-10 rounded-full bg-secondary-900 border border-secondary-700 flex items-center justify-center hover:border-primary-500 hover:text-primary-500 transition-all text-secondary-100">
            IG
          </a>
          <a href="#" class="w-10 h-10 rounded-full bg-secondary-900 border border-secondary-700 flex items-center justify-center hover:border-primary-500 hover:text-primary-500 transition-all text-secondary-100">
            IN
          </a>
        </div>
      </div>

    </div>

    <div class="border-t border-secondary-900 py-8 flex flex-col md:flex-row justify-center items-center gap-4">
      <p class="text-xs text-secondary-500">
        &copy; {new Date().getFullYear()} <span class="text-secondary-300">Servitec Work</span>. Todos los derechos reservados.
      </p>
    </div>
  </ContentWidth>
</footer>